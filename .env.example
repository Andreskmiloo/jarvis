# Clave gratuita de https://api.windy.com/keys (Webcams API) para ver webcams públicas
# en vivo dentro del mapa. Sin ella, la app enlaza al mapa de webcams de Windy.
VITE_WINDY_KEY=

# URL del puente de aviones (Cloudflare Worker de workers/aviones-proxy.js).
# Sin ella la capa de aviones explica cómo activarlo.
VITE_AVIONES_URL=

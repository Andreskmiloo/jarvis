{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perfil-gustos.schema.json",
  "title": "Perfil de gustos",
  "type": "object",
  "required": ["version", "actualizado", "areas"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "actualizado": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "gustos"],
        "additionalProperties": false,
        "properties": {
          "area": { "type": "string", "minLength": 1 },
          "gustos": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "nombre", "nivel", "preferencias", "osm", "palabras_clave", "lugares_conocidos", "notas"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
                "nombre": { "type": "string", "minLength": 1 },
                "nivel": { "type": "integer", "minimum": 1, "maximum": 5 },
                "preferencias": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      { "type": "string" },
                      { "type": "number" },
                      { "type": "boolean" },
                      { "type": "array", "items": { "type": "string" } }
                    ]
                  }
                },
                "osm": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": { "type": "string" }
                  }
                },
                "palabras_clave": { "type": "array", "items": { "type": "string" } },
                "lugares_conocidos": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["nombre", "direccion_o_link", "visitado", "nota"],
                    "additionalProperties": false,
                    "properties": {
                      "nombre": { "type": "string", "minLength": 1 },
                      "direccion_o_link": { "type": "string" },
                      "visitado": { "type": "boolean" },
                      "nota": { "type": "string" }
                    }
                  }
                },
                "notas": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
